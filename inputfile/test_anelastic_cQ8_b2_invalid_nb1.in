&problem_list
 name = 'data/test_anelastic_cQ8_b2_invalid_nb1', problem = 'default',
 response = 'anelastic-cQ8-b2', nblocks = 1, t_final = 0.01d0, CFL = 0.25d0,
 coupling = 'locked', fd_type = 'upwind', order = 4, mesh_source = 'compute',
 type_of_mesh = 'cartesian', material_source = 'hardcode', interpol = F,
 w_stride = 1, w_fault = F, use_topography = F, topo = 1d0, mollify_source = F
/
&block_list
 btp(1)%nqrs = 41, 41, 41, btp(1)%aqrs = -1d0, -1d0, -1d0,
 btp(1)%bqrs = 1d0, 1d0, 1d0, btp(1)%rho_s_p = 2.7d0, 3.464d0, 6d0,
 btp(1)%lqrs = 1, 1, 1, btp(1)%rqrs = 1, 1, 1,
 btp(1)%pml_lqrs = F, F, F, btp(1)%pml_rqrs = F, F, F, btp(1)%npml = 0
/
&anelastic_cQ8_b2_list
 Qs0 = 40d0, 100d0, Qp0 = 80d0, 180d0
/
&output_list
 output_seismograms = F, output_fields_block1 = F, output_fields_block2 = F
/
